# Reverse proxy MAPTA berjalan di port dinamis (default: 8086)
:{$PORT_HTTP:8086} {
    # 1. Routing API ke container backend (Express.js)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:3001
    }

    # 2. Routing file statis jika tersimpan di disk lokal backend
    handle /static/* {
        reverse_proxy backend:3001
    }

    # 3. Routing tampilan SPA ke container frontend (Nginx)
    handle {
        reverse_proxy frontend:80
    }
}
