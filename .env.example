# ==========================================
# MAPTA Production Environment Configuration
# ==========================================

# 1. Domain Publik DuckDNS & Port Akses Baru
# Port 8085 sudah dipakai projek lain, maka MAPTA menggunakan port 8086
DOMAIN=mapta-rahdan.duckdns.org
PORT_HTTP=8086

# 2. Kredensial TiDB Cloud Serverless (MySQL Protocol Port 4000)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_user.root
DB_PASSWORD=your_password
DB_NAME=mapta
DB_SSL=true

# 3. Keamanan Autentikasi JWT
JWT_SECRET=super_secret_jwt_key_mapta_2026_production
