# ==========================================
# MAPTA Production Environment Configuration (Template)
# ==========================================

# 1. Domain Publik DuckDNS & Port Akses Baru
DOMAIN=mapta-rahdan.duckdns.org
PORT_HTTP=8065

# 2. Kredensial TiDB Cloud Serverless (MySQL Protocol Port 4000)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_user.root
DB_PASSWORD=your_password
DB_NAME=mapta
DB_SSL=true

# 3. Keamanan Autentikasi JWT
JWT_SECRET=your_jwt_secret_key_here

# 4. Konfigurasi Client Firebase Web SDK (Notifikasi Realtime)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
